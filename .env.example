# ==============================================================================
# SE Ranking Studio - Environment Configuration Template (.env.example)
# Use this template for local development (.env.local) and Vercel deployment.
# NEVER commit real credentials, tokens, or secret keys to Git.
# ==============================================================================

# ==============================================================================
# 1. DATABASE (Supabase PostgreSQL / PgBouncer Pooler)
# ==============================================================================
# Pooled connection string (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=seranking"

# Direct connection string for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=seranking"

# ==============================================================================
# 2. SUPABASE CLOUD API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_ID=[YOUR-PROJECT-REF]
SUPABASE_DB_PASSWORD=your-db-password

# ==============================================================================
# 3. APPLICATION URL & ENVIRONMENT
# ==============================================================================
# Local: http://localhost:3000 | Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ==============================================================================
# 4. AUTHENTICATION & SESSION SECRETS (Server-Only)
# ==============================================================================
# 32+ character random secret used for session cookie HMAC signing and JWT
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters
NEXTAUTH_SECRET=your-secure-nextauth-secret-key

# Google OAuth 2.0 (Sign in with Google)
# Site redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================================================================
# 5. SECURITY & BOT DEFENSE (Cloudflare Turnstile & Google reCAPTCHA)
# ==============================================================================
# Cloudflare Turnstile (Next-gen CAPTCHA alternative)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# Google reCAPTCHA v2 (Checkbox)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-google-recaptcha-v2-site-key
RECAPTCHA_SECRET_KEY=your-google-recaptcha-v2-secret-key


# ==============================================================================
# 6. SEO, SERP & RANKINGS ENGINES
# ==============================================================================
SEO_PROVIDER_MODE=real
RANKING_PROVIDER=serper

# Serper.dev API (Live Google SERP & Positions)
SERPER_API_KEY=your-serper-api-key

# DataForSEO API (Deep Keywords & Backlink Data)
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password
DATAFORSEO_API_KEY=your-dataforseo-api-key

# SE Ranking Data API
SE_RANKING_API_TOKEN=your-seranking-api-token
SE_RANKING_DATA_API_KEY=your-seranking-data-api-key
SE_RANKING_API_BASE_URL=https://api.seranking.com/v1

# ==============================================================================
# 7. AI SEARCH INTELLIGENCE (ChatGPT, Gemini, Perplexity)
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key

# ==============================================================================
# 8. EMAIL SMTP (Gmail Verified Alerts & Verification)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_APP_PASSWORD=your-smtp-app-password
SMTP_FROM="SE Ranking Studio <your-smtp-user@gmail.com>"

# ==============================================================================
# 9. CLOUDFLARE R2 OBJECT STORAGE (Assets, Exports & Favicons)
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_S3_ENDPOINT=https://[ACCOUNT-ID].r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=seranking
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://[ACCOUNT-ID].r2.cloudflarestorage.com/seranking
